# ==============================================================================
# TraceMind Master Environment Configuration Template
# Copy relevant sections to src/backend/.env and src/frontend/.env
# ==============================================================================

# Backend Environment Variables (src/backend/.env)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# AI & Third-Party Service Keys (if applicable)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (if applicable)
# DATABASE_URL=mongodb://localhost:27017/tracemind
# PG_CONNECTION_STRING=postgresql://user:password@localhost:5432/tracemind

# Frontend Environment Variables (src/frontend/.env)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_TITLE=TraceMind
