# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/tracemind

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Nodemailer / SMTP Email Service Configuration
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=your-email@gmail.com, SMTP_PASS=your-app-password
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM_NAME="TraceMind AI"
EMAIL_FROM_ADDRESS="no-reply@tracemind.ai"

# Optional / Future AI & Service Keys
# GEMINI_API_KEY=
